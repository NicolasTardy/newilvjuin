[Unit]
Description=ILV Credit BUT - generateur PDF A3 (Flask/Gunicorn)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/newilv
Environment="PATH=/var/www/newilv/venv/bin"
# Gunicorn sert l'app Flask "app" du module serve_local sur le port local 8766
ExecStart=/var/www/newilv/venv/bin/gunicorn \
    --workers 2 \
    --threads 4 \
    --timeout 120 \
    --bind 127.0.0.1:8766 \
    serve_local:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
